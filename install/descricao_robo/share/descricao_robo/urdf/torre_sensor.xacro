<?xml version="1.0"?>
<!-- ===================================================================
     torre_sensor.xacro
     DR3 / Etapa 2 - exemplo de propriedades, expressoes e macro
     =================================================================== -->
<robot name="torre_sensor" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="raio_base"     value="0.15"/>
  <xacro:property name="altura_base"   value="0.08"/>
  <xacro:property name="raio_mastro"   value="0.04"/>
  <xacro:property name="altura_mastro" value="0.40"/>
  <xacro:property name="curso_elev"    value="0.25"/>
  <xacro:property name="raio_camisa"   value="0.055"/>
  <!-- camisa >= curso + folga: garante que o mastro nunca se descole -->
  <xacro:property name="alt_camisa"    value="${curso_elev + 0.05}"/>

  <material name="cinza">
    <color rgba="0.50 0.50 0.55 1.0"/>
  </material>
  <material name="laranja">
    <color rgba="0.90 0.50 0.10 1.0"/>
  </material>

  <!-- macro reutilizavel: qualquer sensor em caixa, preso por joint fixed -->
  <xacro:macro name="sensor_caixa" params="nome pai x y z massa">
    <link name="${nome}">
      <visual>
        <geometry>
          <box size="0.04 0.06 0.04"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <box size="0.04 0.06 0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${massa}"/>
        <inertia ixx="1e-4" ixy="0.0" ixz="0.0"
                 iyy="1e-4" iyz="0.0" izz="1e-4"/>
      </inertial>
    </link>

    <joint name="junta_${nome}" type="fixed">
      <parent link="${pai}"/>
      <child  link="${nome}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <link name="base_torre">
    <visual>
      <origin xyz="0 0 ${altura_base/2}"/>
      <geometry>
        <cylinder radius="${raio_base}" length="${altura_base}"/>
      </geometry>
      <material name="cinza"/>
    </visual>
    <visual>
      <origin xyz="0 0 ${altura_base + alt_camisa/2}"/>
      <geometry>
        <cylinder radius="${raio_camisa}" length="${alt_camisa}"/>
      </geometry>
      <material name="cinza"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${altura_base/2}"/>
      <geometry>
        <cylinder radius="${raio_base}" length="${altura_base}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${altura_base/2}"/>
      <mass value="4.0"/>
      <inertia ixx="0.02463" ixy="0.0" ixz="0.0"
               iyy="0.02463" iyz="0.0" izz="0.04500"/>
    </inertial>
  </link>

  <link name="mastro">
    <visual>
      <origin xyz="0 0 ${altura_mastro/2}"/>
      <geometry>
        <cylinder radius="${raio_mastro}" length="${altura_mastro}"/>
      </geometry>
      <material name="cinza"/>
    </visual>
    <inertial>
      <origin xyz="0 0 ${altura_mastro/2}"/>
      <mass value="1.2"/>
      <inertia ixx="0.01648" ixy="0.0" ixz="0.0"
               iyy="0.01648" iyz="0.0" izz="0.00096"/>
    </inertial>
  </link>

  <joint name="junta_elevacao" type="prismatic">
    <parent link="base_torre"/>
    <child  link="mastro"/>
    <origin xyz="0 0 ${altura_base}"/>
    <axis   xyz="0 0 1"/>
    <limit lower="0.0" upper="${curso_elev}" effort="50.0" velocity="0.10"/>
  </joint>

  <link name="cabeca_pan">
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry>
        <box size="0.12 0.12 0.06"/>
      </geometry>
      <material name="laranja"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0.03"/>
      <mass value="0.6"/>
      <inertia ixx="0.00090" ixy="0.0" ixz="0.0"
               iyy="0.00090" iyz="0.0" izz="0.00144"/>
    </inertial>
  </link>

  <joint name="junta_pan" type="revolute">
    <parent link="mastro"/>
    <child  link="cabeca_pan"/>
    <origin xyz="0 0 ${altura_mastro}"/>
    <axis   xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="1.5"/>
  </joint>

  <link name="suporte_tilt">
    <visual>
      <geometry>
        <box size="0.10 0.08 0.04"/>
      </geometry>
      <material name="laranja"/>
    </visual>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.00020" ixy="0.0" ixz="0.0"
               iyy="0.00029" iyz="0.0" izz="0.00041"/>
    </inertial>
  </link>

  <joint name="junta_tilt" type="revolute">
    <parent link="cabeca_pan"/>
    <child  link="suporte_tilt"/>
    <origin xyz="0 0 0.06"/>
    <axis   xyz="0 1 0"/>
    <limit lower="-0.60" upper="0.60" effort="8.0" velocity="1.0"/>
  </joint>

  <!-- a macro instanciada: a camera -->
  <xacro:sensor_caixa nome="camera_link" pai="suporte_tilt"
                      x="0.06" y="0" z="0" massa="0.1"/>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1.667e-4" ixy="0.0" ixz="0.0"
               iyy="1.667e-4" iyz="0.0" izz="2.500e-4"/>
    </inertial>
  </link>

  <joint name="junta_lidar" type="continuous">
    <parent link="base_torre"/>
    <child  link="lidar_link"/>
    <origin xyz="0.10 0 ${altura_base}"/>
    <axis   xyz="0 0 1"/>
  </joint>

</robot>
