<?xml version="1.0"?>
<!-- ===================================================================
     robo_diff_gazebo.xacro   -   DR3 / TP2 - Exercicio 1
     Reaproveita o robo_diff.xacro do TP1 e acrescenta:
       - LiDAR (link + joint fixed)
       - plugin libgazebo_ros_diff_drive.so   -> /cmd_vel e /odom
       - plugin libgazebo_ros_ray_sensor.so   -> /scan
       - atrito das rodas e do castor
     Expandir para conferir:
       xacro robo_diff_gazebo.xacro > /tmp/gz.urdf && check_urdf /tmp/gz.urdf
     =================================================================== -->
<robot name="robo_diff" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- traz links, joints e propriedades do TP1 -->
  <xacro:include filename="$(find descricao_robo)/urdf/robo_diff.xacro"/>

  <!-- ====================== LiDAR: link e joint ====================== -->
  <link name="laser_frame">
    <visual>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="preto"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="3.0e-5" ixy="0.0" ixz="0.0"
               iyy="3.0e-5" iyz="0.0" izz="4.5e-5"/>
    </inertial>
  </link>

  <joint name="junta_laser" type="fixed">
    <parent link="base_link"/>
    <child  link="laser_frame"/>
    <origin xyz="0.10 0 0.07" rpy="0 0 0"/>
  </joint>

  <!-- ====================== Atrito (sem isto nao anda) =============== -->
  <gazebo reference="roda_esq">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="roda_dir">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="roda_apoio">
    <!-- castor desliza: atrito zero -->
    <mu1>0.0</mu1><mu2>0.0</mu2>
  </gazebo>

  <!-- ====================== Plugin de tracao diferencial ============= -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>30</update_rate>

      <!-- precisam ser os nomes EXATOS dos joints do URDF -->
      <left_joint>junta_roda_esq</left_joint>
      <right_joint>junta_roda_dir</right_joint>

      <!-- 2 x 0.12 m entre rodas; diametro 2 x raio_roda -->
      <wheel_separation>0.24</wheel_separation>
      <wheel_diameter>0.10</wheel_diameter>

      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
    </plugin>
  </gazebo>

  <!-- ====================== Plugin de LiDAR ========================== -->
  <gazebo reference="laser_frame">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="scan" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
