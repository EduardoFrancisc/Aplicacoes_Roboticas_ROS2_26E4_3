<?xml version="1.0"?>
<!-- ===================================================================
     torre_sensor.urdf
     DR3 - Aplicacoes Roboticas com ROS 2 / Etapa 1
     Modelo de estudo: torre pan-tilt de inspecao.
     Exercita os quatro tipos de junta usados na disciplina:
       prismatic  - junta_elevacao (mastro telescopico)
       revolute   - junta_pan, junta_tilt (com <limit> obrigatorio)
       fixed      - junta_camera
       continuous - junta_lidar (LiDAR rotativo)
     =================================================================== -->
<robot name="torre_sensor">

  <material name="cinza">
    <color rgba="0.50 0.50 0.55 1.0"/>
  </material>
  <material name="laranja">
    <color rgba="0.90 0.50 0.10 1.0"/>
  </material>
  <material name="preto">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <!-- ============================ BASE (raiz) ============================ -->
  <link name="base_torre">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
      <material name="cinza"/>
    </visual>
    <visual>
      <!-- camisa externa: guia fixa de onde o mastro telescopico sai.
           Sem ela o mastro se descola da base ao subir. -->
      <origin xyz="0 0 0.23" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.30"/>
      </geometry>
      <material name="cinza"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.08"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.23" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.30"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="4.0"/>
      <!-- cilindro solido: ixx=iyy=m/12*(3r^2+h^2), izz=m*r^2/2 -->
      <inertia ixx="0.02463" ixy="0.0" ixz="0.0"
               iyy="0.02463" iyz="0.0" izz="0.04500"/>
    </inertial>
  </link>

  <!-- ========================= MASTRO (prismatic) ========================= -->
  <link name="mastro">
    <visual>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.40"/>
      </geometry>
      <material name="cinza"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.40"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.01648" ixy="0.0" ixz="0.0"
               iyy="0.01648" iyz="0.0" izz="0.00096"/>
    </inertial>
  </link>

  <joint name="junta_elevacao" type="prismatic">
    <parent link="base_torre"/>
    <child  link="mastro"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit lower="0.0" upper="0.25" effort="50.0" velocity="0.10"/>
  </joint>

  <!-- ========================== CABECA (revolute Z) ======================= -->
  <link name="cabeca_pan">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.06"/>
      </geometry>
      <material name="laranja"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.00090" ixy="0.0" ixz="0.0"
               iyy="0.00090" iyz="0.0" izz="0.00144"/>
    </inertial>
  </link>

  <joint name="junta_pan" type="revolute">
    <parent link="mastro"/>
    <child  link="cabeca_pan"/>
    <origin xyz="0 0 0.40" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="1.5"/>
  </joint>

  <!-- ========================= SUPORTE (revolute Y) ======================= -->
  <link name="suporte_tilt">
    <visual>
      <geometry>
        <box size="0.10 0.08 0.04"/>
      </geometry>
      <material name="laranja"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.10 0.08 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.00020" ixy="0.0" ixz="0.0"
               iyy="0.00029" iyz="0.0" izz="0.00041"/>
    </inertial>
  </link>

  <joint name="junta_tilt" type="revolute">
    <parent link="cabeca_pan"/>
    <child  link="suporte_tilt"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis   xyz="0 1 0"/>
    <limit lower="-0.60" upper="0.60" effort="8.0" velocity="1.0"/>
  </joint>

  <!-- ============================ CAMERA (fixed) ========================== -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.04 0.06 0.04"/>
      </geometry>
      <material name="preto"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.06 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.10"/>
      <inertia ixx="1e-4" ixy="0.0" ixz="0.0"
               iyy="1e-4" iyz="0.0" izz="1e-4"/>
    </inertial>
  </link>

  <joint name="junta_camera" type="fixed">
    <parent link="suporte_tilt"/>
    <child  link="camera_link"/>
    <origin xyz="0.06 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================= LIDAR (continuous) ========================= -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="preto"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.20"/>
      <inertia ixx="1.667e-4" ixy="0.0" ixz="0.0"
               iyy="1.667e-4" iyz="0.0" izz="2.500e-4"/>
    </inertial>
  </link>

  <joint name="junta_lidar" type="continuous">
    <parent link="base_torre"/>
    <child  link="lidar_link"/>
    <origin xyz="0.10 0 0.08" rpy="0 0 0"/>
    <axis   xyz="0 0 1"/>
  </joint>

</robot>
